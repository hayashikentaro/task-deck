{
  "name": "task-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "taskdeckctl": "scripts/taskdeckctl.mjs"
  },
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/core"
  ],
  "scripts": {
    "dev": "node scripts/dev-supervisor.js",
    "dev:server": "npm --workspace @taskdeck/server run dev",
    "build": "npm --workspace @taskdeck/web run build",
    "start": "npm --workspace @taskdeck/server run start",
    "test": "npm --workspace @taskdeck/web run test"
  }
}
